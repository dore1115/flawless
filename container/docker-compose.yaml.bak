# TODO(REQ-NF-G-007 부하테스트/모니터링 표준 부재): 컨테이너 리소스 제한이 전혀 없어서
# 개발 환경 스펙에 따라 "서비스 불능 시작 지점"이 매번 달라진다.
# -> 각 서비스에 deploy.resources.limits (예: cpus: '1', memory: 1G) 추가하고,
#    Prometheus/Grafana 서비스도 이 compose 파일에 함께 추가해 지표 수집 표준화할 것.
services:
  app:
    build:
      context: ./
      dockerfile: Dockerfile
    container_name: erp-app
    ports:
      - "8080:8080"
    environment:
      SPRING_PROFILES_ACTIVE: docker
      SPRING_DATASOURCE_URL: ${DB_URL}
      SPRING_DATASOURCE_USERNAME: ${DB_USERNAME}
      SPRING_DATASOURCE_PASSWORD: ${DB_PASSWORD}
    depends_on:
      - mysql
    networks:
      - erp-net
    mem_limit: 1g
    cpus: 1.0

  mysql:
    image: mysql:8.0
    container_name: erp-mysql
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MYSQL_DATABASE: erp
      MYSQL_USER: ${DB_USERNAME}
      MYSQL_PASSWORD: ${DB_PASSWORD}
    ports:
      - '3306:3306'
    volumes:
      - mysql-data:/var/lib/mysql
      - ./mysql-init:/docker-entrypoint-initdb.d
    networks:
      - erp-net

  prometheus:
    image: prom/prometheus:v2.53.0
    container_name: erp-prometheus
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "9090:9090"
    depends_on:
      - app
    networks:
      - erp-net

  grafana:
    image: grafana/grafana:11.1.0
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: ${GF_SECURITY_ADMIN_USER}
      GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD}
      GF_AUTH_ANONYMOUS_ENABLED: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning
      - grafana-data:/var/lib/grafana
    depends_on:
      - prometheus
    networks:
      - erp-net

networks:
  erp-net:
    driver: bridge

volumes:
  mysql-data:
  prometheus-data:
  grafana-data: